generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model School {
  id            String                 @id @default(uuid())
  schoolId      String                 @unique
  olympiadId    String
  name          String
  address       String?
  email         String?
  phone         String?
  contactPerson String?
  city          String?
  state         String?
  pincode       String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  password      String?
  username      String?                @unique
  plainPassword String?
  district      String?
  districtCode  String?
  stateCode     String?
  isActive      Boolean                @default(true)
  olympiadIds   OlympiadIdAllocation[]
  linkRequests  SchoolLinkRequest[]

  @@schema("public")
}

model Uploader {
  id            String   @id @default(uuid())
  uploaderId    String   @unique
  name          String
  email         String?
  phone         String?
  username      String   @unique
  password      String
  plainPassword String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model OlympiadIdAllocation {
  id           String    @id @default(uuid())
  code         String    @unique
  prefix       String
  sequence     Int
  classCode    String?
  className    String?
  schoolId     String
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  assignedName String?
  assignedAt   DateTime?
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?

  @@index([schoolId])
  @@schema("public")
}

model Student {
  id            String               @id @default(uuid())
  olympiadCode  String               @unique
  name          String
  phone         String
  password      String?
  username      String?              @unique
  isVerified    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  plainPassword String?
  allocation    OlympiadIdAllocation @relation(fields: [olympiadCode], references: [code], onDelete: Cascade)
  videos        Video[]

  @@schema("public")
}

model Video {
  id              String           @id @default(uuid())
  studentId       String?
  appUserId       String?
  uploaderType    String           @default("STUDENT")
  videoUrl        String
  thumbnailUrl    String?
  caption         String?
  category        String?
  subCategory     String?
  tags            String?
  status          String           @default("PENDING")
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isEvaluation    Boolean          @default(false)
  isPublic        Boolean          @default(true)
  olympiadVisibility String?       // "public" | "private" — only meaningful when isEvaluation = true
  likesCount      Int              @default(0)
  viewsCount      Int              @default(0)
  deletedAt       DateTime?
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  likes           Like[]
  views           VideoView[]
  reelShares      ReelShare[]
  evaluations     VideoEvaluation[]
  reports         VideoReport[]

  @@index([studentId])
  @@index([appUserId])
  @@index([status])
  @@index([status, isPublic])
  @@index([deletedAt])
  @@schema("public")
}

// Kosh = one of the five Panchkosh evaluation lenses. Each video is scored on
// 5 criteria (0-4 each), each criterion mapped 1:1 to a kosha (see
// KOSH_CRITERIA in src/lib/kosh.ts). A student's per-kosha grade sums the
// matching criterion from both videos (max 8) and is banded
// Beginner (1-4) / Progressing (4.1-6) / Proficient (6.1-8).
enum Kosh {
  ANNAMAYA
  PRANAMAYA
  MANOMAYA
  VIJNANAMAYA
  ANANDAMAYA

  @@schema("public")
}

// One row per video (single scoring form). Criterion→kosha mapping:
// coordination→Annamaya, memoryEnergy→Pranamaya, imaginationEmotion→Manomaya,
// focusLanguage→Vijnanamaya (labeled "Focus" for video 1, "Language" for
// video 2), creativityJoy→Anandamaya. Each criterion is 0-4; totalScore 0-20.
model VideoEvaluation {
  id                      String          @id @default(uuid())
  videoId                 String          @unique
  evaluatorId             String
  coordinationScore       Int
  memoryEnergyScore       Int
  imaginationEmotionScore Int
  focusLanguageScore      Int
  creativityJoyScore      Int
  totalScore              Int
  remarks                 String?
  isPublished             Boolean         @default(false)
  publishedAt             DateTime?
  lastEditedBy            String?
  lastEditedAt            DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  video                   Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  evaluator               TalentEvaluator @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([evaluatorId])
  @@schema("public")
}

model Viewer {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Reviewer {
  id                   String                 @id @default(uuid())
  reviewerId           String                 @unique
  name                 String
  email                String                 @unique
  password             String
  plainPassword        String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  individualPermission IndividualPermissions?

  @@schema("public")
}

model Moderator {
  id                   String                 @id @default(uuid())
  moderatorId          String                 @unique
  name                 String
  email                String                 @unique
  password             String
  plainPassword        String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  individualPermission IndividualPermissions?

  @@schema("public")
}

model TalentEvaluator {
  id                   String                 @id @default(uuid())
  evaluatorId          String                 @unique
  name                 String
  email                String                 @unique
  password             String
  plainPassword        String?
  isActive             Boolean                @default(true)
  // Empty arrays = unrestricted (evaluator sees every region). Non-empty =
  // evaluator only sees videos whose student's school state/district matches
  // one of these — checked in evaluation-queue and evaluate routes.
  assignedStates       String[]               @default([])
  assignedDistricts    String[]               @default([])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  individualPermission IndividualPermissions?
  evaluations          VideoEvaluation[]

  @@schema("public")
}

model RolePermissions {
  id             String   @id @default(uuid())
  role           String   @unique
  allowedModules String[]
  updatedAt      DateTime @updatedAt

  @@schema("public")
}

model IndividualPermissions {
  id             String           @id @default(uuid())
  memberId       String           @unique
  role           String
  allowedModules String[]
  reviewerId     String?          @unique
  evaluatorId    String?          @unique
  moderatorId    String?          @unique
  updatedAt      DateTime         @updatedAt
  reviewer       Reviewer?        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  evaluator      TalentEvaluator? @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  moderator      Moderator?       @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Like {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  userType  String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([videoId])
  @@schema("public")
}

model VideoView {
  id        String   @id @default(uuid())
  videoId   String
  sessionId String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([videoId, sessionId])
  @@schema("public")
}

model AppUser {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  email                  String?
  mobile                 String?
  avatarUrl              String?
  password               String
  plainPassword          String?
  termsAccepted          Boolean         @default(false)
  otpHash                String?
  otpExpiresAt           DateTime?
  isVerified             Boolean         @default(false)
  olympiadId             String?
  isPrivate              Boolean         @default(false)
  // Account deletion — see AccountDeletionRequest for the student-side
  // (admin-approved) path. This field only ever gets set for a viewer
  // (no olympiadId): tapping "Delete Account" stamps it immediately, which
  // hides the account/videos everywhere (see visibilityWhere) and logs them
  // out. Logging back in before the 30-day sweep clears it — see login route.
  // The sweep (api/cron/sweep-deleted-accounts) hard-deletes anyone still set
  // 30+ days later.
  deletionRequestedAt    DateTime?
  // Stamped on every successful login — the only signal the 30-day sweep and
  // the login route need to tell "came back in time" from "still gone".
  lastLoginAt            DateTime?
  olympiadCatAApproved   Boolean         @default(false)
  olympiadCatBApproved   Boolean         @default(false)
  // Free-text school name typed by a user whose school is not registered on
  // Mittmee. Purely a profile label: it builds no linkage and never surfaces a
  // video on any school portal — SchoolLinkRequest is the only real link.
  unlistedSchoolName     String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  followers              Follow[]        @relation("UserFollowers")
  following              Follow[]        @relation("UserFollowing")
  followRequestsSent     FollowRequest[] @relation("FollowRequestSender")
  followRequestsReceived FollowRequest[] @relation("FollowRequestReceiver")
  reelSharesSent         ReelShare[]     @relation("ReelShareSender")
  reelSharesReceived     ReelShare[]     @relation("ReelShareRecipient")
  reportsSubmitted       VideoReport[]
  supportTickets         SupportTicket[]
  notifications          Notification[]
  schoolLinkRequests     SchoolLinkRequest[]
  deletionRequests       AccountDeletionRequest[]

  @@index([email])
  @@index([mobile])
  @@index([deletionRequestedAt])
  @@schema("public")
}

model AppOtp {
  id         String   @id @default(uuid())
  identifier String   @unique
  otpHash    String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@schema("public")
}

model PasswordResetOtp {
  id         String   @id @default(uuid())
  identifier String   @unique
  otpHash    String
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@schema("public")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    AppUser  @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   AppUser  @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@schema("public")
}

model FollowRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     AppUser  @relation("FollowRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   AppUser  @relation("FollowRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@schema("public")
}

model ReelShare {
  id          String    @id @default(uuid())
  videoId     String
  senderId    String
  recipientId String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sender      AppUser   @relation("ReelShareSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   AppUser   @relation("ReelShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId, recipientId])
  @@index([videoId])
  @@schema("public")
}

model VideoReport {
  id           String   @id @default(uuid())
  videoId      String
  reporterId   String
  ownerId      String?
  category     String   // ABUSIVE_CONTENT | SPAM | HARASSMENT | HATE_SPEECH | VIOLENCE | SEXUAL_CONTENT | MISINFORMATION | COPYRIGHT | OTHER
  customReason String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter     AppUser  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([videoId, reporterId])
  @@index([videoId])
  @@index([reporterId])
  @@schema("public")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model SupportTicket {
  id             String   @id @default(uuid())
  userId         String
  type           String   @default("TECHNICAL") // TECHNICAL | REMARK
  category       String?  // App Crash | Video Upload Issue | Login/Account Access | Video Playback Issue | Other Technical (TECHNICAL only)
  message        String
  screenshotUrls String?  // comma-separated URLs, up to 3
  status         String   @default("OPEN") // OPEN | RESOLVED
  resolvedAt     DateTime?
  adminResponse  String?   // reply written by SuperAdmin
  respondedAt    DateTime?
  isReadByUser   Boolean  @default(true) // flips to false when adminResponse is set, until the user opens the notifications modal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@schema("public")
}

// Append-only trail of every moderation/evaluation action taken by staff
// (admins, evaluators, schools), so "who did what, when" is always answerable —
// unlike the mutable status fields on Video/VideoEvaluation/VideoReport, rows
// here are never updated or deleted.
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    String   // SUPERADMIN | EVALUATOR | SCHOOL | REVIEWER
  actorName    String?  // denormalised at write time so the log stays readable if the actor is later removed
  action       String   // e.g. VIDEO_APPROVED, VIDEO_REJECTED, VIDEO_DELETED, VISIBILITY_CHANGED, REPORT_IGNORED, REPORT_VIDEO_REMOVED, EVALUATION_SUBMITTED, EVALUATION_PUBLISHED, EVALUATION_UNPUBLISHED
  entityType   String   // e.g. Video, VideoEvaluation, VideoReport
  entityId     String
  previousValue String? // JSON snapshot of relevant fields before the change
  newValue     String?  // JSON snapshot of relevant fields after the change
  reason       String?  // e.g. rejection reason, report resolution note
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@schema("public")
}

// Generic system-originated alerts for the app's Home-screen notification bell
// (used for admin video removals, approvals/rejections, and star/like alerts;
// separate from SupportTicket responses, which are fetched via /api/app/support/notifications).
model Notification {
  id             String   @id @default(uuid())
  userId         String
  type           String   // "VIDEO_REMOVED" | "VIDEO_APPROVED" | "VIDEO_REJECTED" | "VIDEO_LIKED" | "FOLLOW" | "FOLLOW_REQUEST"
  title          String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  videoId        String?  // links back to the video, e.g. for VIDEO_LIKED aggregation
  actorId        String?  // AppUser.id of whoever triggered this (FOLLOW / FOLLOW_REQUEST)
  count          Int      @default(1)      // how many actors this row represents (VIDEO_LIKED)
  recentActorIds String[] @default([])     // most recent likers' userIds, for "X and N others"
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, videoId, type, isRead])
  @@schema("public")
}

// Links an app user to a registered school WITHOUT an Olympiad ID.
// A student who never sat the Olympiad has no OlympiadIdAllocation, so the
// School -> allocation -> AppUser.olympiadId chain can never reach them. This
// model is the second, request-based path: the user asks, the school approves,
// and from then on their videos appear on that school portal and on the school
// page in the app. It grants nothing else — no Olympiad entry, no permissions.
model SchoolLinkRequest {
  id         String    @id @default(uuid())
  appUserId  String
  schoolId   String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  decidedAt  DateTime?
  appUser    AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // One row per (user, school) so a rejected user can re-request the same
  // school by flipping this row back to PENDING rather than stacking history.
  @@unique([appUserId, schoolId])
  @@index([appUserId, status])
  @@index([schoolId, status])
  @@schema("public")
}

// Student/Olympiad-user side of account deletion (viewers instead go through
// AppUser.deletionRequestedAt + the 30-day sweep — no admin step needed since
// there's no institutional data at stake). A student has real Olympiad
// history, so a SuperAdmin has to approve before anything is wiped. Approving
// hard-deletes the AppUser (and everything under it, videos included) via
// lib/accountDeletion.ts, which takes this row down with it — nothing to
// clean up here after an approval. A rejected request leaves this row as
// history and the user is free to submit a new one any time.
model AccountDeletionRequest {
  id         String    @id @default(uuid())
  appUserId  String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  appUser    AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, status])
  @@index([status])
  @@schema("public")
}
